// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Uses DATABASE_URL env var. We set DATABASE_URL in .env to the Neon
  // non-pooled URL for migrations / `prisma db push`.
  // At runtime, src/lib/db.ts overrides with the pooled URL when available.
  url = env("DATABASE_URL")
}

model ShortUrl {
  id          String   @id @default(cuid())
  shortCode   String   @unique
  originalUrl String
  title       String?
  visits      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shortCode])
}
